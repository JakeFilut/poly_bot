# =============================================================================
# POLYMARKET TRADER - Environment Variables
# =============================================================================
# Copy to .env (in repo root or ../keys/.env) and fill in your values.
# NEVER commit .env to git!

# ---------------------------------------------------------------------------
# REQUIRED: Polymarket wallet private key
# ---------------------------------------------------------------------------
# Your Ethereum private key (starts with 0x)
# Get from MetaMask: Settings > Security & Privacy > Show private key
POLYMARKET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ---------------------------------------------------------------------------
# OPTIONAL: Override defaults
# ---------------------------------------------------------------------------
# DEBUG=false
# SCAN_INTERVAL_SECONDS=5.0
# MIN_BET_DOLLARS=3.00
# MAX_TRADE_QTY=50
# KEYS_DIR=../keys
# LOG_DIR=./logs
